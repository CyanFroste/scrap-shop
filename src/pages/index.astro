---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PickupForm from '../components/PickupForm';
import ContactSection from '../components/ContactSection.astro';
import { siteConfig } from '../config/site';
---

<Layout
  title={`${siteConfig.siteName} — Doorstep Scrap Pickup Service`}
  description={siteConfig.subtagline}
>
  <!-- Hero Section with Picture & Tagline -->
  <Hero />

  <!-- Schedule a Call / Pickup Form -->
  <PickupForm client:load whatsappNumber={siteConfig.whatsappNumber} />

  <!-- Contact & Address Section -->
  <ContactSection />
</Layout>
