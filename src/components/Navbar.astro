---
import { siteConfig } from '../config/site';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<header class="sticky top-0 z-50 bg-white/90 dark:bg-zinc-900/90 backdrop-blur-md border-b border-zinc-200 dark:border-zinc-800 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Left: Brand & Navigation Links aligned together -->
    <div class="flex items-center gap-8">
      <!-- Brand -->
      <a href={base} class="flex items-center gap-2.5 group">
        <div class="w-10 h-10 rounded-xl bg-emerald-600 dark:bg-emerald-500 text-white flex items-center justify-center font-bold text-xl shadow-sm group-hover:scale-105 transition-transform">
          ♻️
        </div>
        <div>
          <span class="text-xl font-bold tracking-tight text-zinc-900 dark:text-white flex items-center gap-1.5">
            {siteConfig.siteName}
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
          </span>
          <span class="block text-xs text-zinc-500 dark:text-zinc-400 font-medium">Scrap Pickup Service</span>
        </div>
      </a>

      <!-- Navigation Links on Left -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
        <a 
          href={base} 
          class="text-zinc-700 dark:text-zinc-200 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
        >
          Home
        </a>
        <a 
          href={`${base}prices`} 
          class="text-zinc-700 dark:text-zinc-200 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors flex items-center gap-1.5"
        >
          <span>Scrap Rates</span>
          <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-emerald-100 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300">
            Live Prices
          </span>
        </a>
      </nav>
    </div>

    <!-- Right: Call <number> CTA -->
    <div class="flex items-center gap-3">
      <a
        href={`tel:${siteConfig.phoneClean}`}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs sm:text-sm font-bold shadow-sm hover:shadow transition-all cursor-pointer"
        aria-label={`Call ${siteConfig.phone}`}
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
        </svg>
        <span>Call {siteConfig.phone}</span>
      </a>
    </div>
  </div>
</header>
