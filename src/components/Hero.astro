---
import { siteConfig } from '../config/site';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<section class="relative overflow-hidden pt-12 pb-16 lg:pt-20 lg:pb-24 bg-gradient-to-b from-emerald-50/50 via-white to-zinc-50 dark:from-emerald-950/20 dark:via-zinc-950 dark:to-zinc-950">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Copy & Tagline -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-100 dark:bg-emerald-950/80 border border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs sm:text-sm font-semibold">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Doorstep Scrap Collection Service</span>
        </div>

        <!-- Tagline & Heading -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-white leading-[1.15]">
          {siteConfig.tagline}
        </h1>

        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl">
          {siteConfig.subtagline}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <!-- Primary CTA: Call <number> -->
          <a
            href={`tel:${siteConfig.phoneClean}`}
            class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm sm:text-base shadow-md hover:shadow-lg transition-all transform active:scale-95 cursor-pointer flex items-center gap-2.5"
            aria-label={`Call ${siteConfig.phone}`}
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
            <span>Call {siteConfig.phone}</span>
          </a>

          <!-- Secondary CTA: WhatsApp -->
          <a
            href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-3.5 rounded-xl bg-white dark:bg-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-100 border border-zinc-300 dark:border-zinc-700 font-semibold text-sm sm:text-base shadow-sm transition-all flex items-center gap-2"
          >
            <svg class="w-5 h-5 fill-current text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.489.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>WhatsApp Us</span>
          </a>

          <a
            href={`${base}prices`}
            class="px-4 py-3.5 text-sm font-semibold text-emerald-700 dark:text-emerald-400 hover:underline flex items-center gap-1"
          >
            <span>Check Rates</span>
            <span>→</span>
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-zinc-200 dark:border-zinc-800">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">🚚</span>
            <div>
              <p class="text-xs font-bold text-zinc-900 dark:text-white">Free Doorstep</p>
              <p class="text-[11px] text-zinc-500">Scheduled pickup</p>
            </div>
          </div>

          <div class="flex items-center gap-2.5">
            <span class="text-xl">⚖️</span>
            <div>
              <p class="text-xs font-bold text-zinc-900 dark:text-white">Digital Scale</p>
              <p class="text-[11px] text-zinc-500">100% accurate</p>
            </div>
          </div>

          <div class="flex items-center gap-2.5">
            <span class="text-xl">💵</span>
            <div>
              <p class="text-xs font-bold text-zinc-900 dark:text-white">Instant Pay</p>
              <p class="text-[11px] text-zinc-500">UPI or Cash</p>
            </div>
          </div>

          <div class="flex items-center gap-2.5">
            <span class="text-xl">🌱</span>
            <div>
              <p class="text-xs font-bold text-zinc-900 dark:text-white">Eco Recycling</p>
              <p class="text-[11px] text-zinc-500">Zero landfill goal</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Hero Picture / Visual Template -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-md">
          <!-- Ambient Glow Effect -->
          <div class="absolute -inset-2 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-3xl blur-2xl opacity-20 dark:opacity-30"></div>

          <!-- Picture Card Container -->
          <div class="relative bg-white dark:bg-zinc-800 rounded-2xl p-4 shadow-xl border border-zinc-200 dark:border-zinc-700 overflow-hidden">
            <!-- Modern Responsive Scrap Pickup Vector Art -->
            <div class="w-full aspect-[4/3] rounded-xl bg-gradient-to-br from-emerald-100 via-teal-50 to-zinc-100 dark:from-emerald-950/60 dark:via-zinc-800 dark:to-zinc-900 flex flex-col items-center justify-center p-6 text-center border border-emerald-200 dark:border-emerald-800/50">
              <svg class="w-24 h-24 text-emerald-600 dark:text-emerald-400 mb-3" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Recycling Circle -->
                <circle cx="50" cy="50" r="44" stroke="currentColor" stroke-width="3" stroke-dasharray="6 6" opacity="0.4" />
                <!-- Pickup Truck & Scrap Container -->
                <rect x="22" y="44" width="34" height="22" rx="3" fill="#10B981" />
                <path d="M56 50H68L76 66H56V50Z" fill="#059669" />
                <rect x="58" y="52" width="10" height="7" rx="1.5" fill="#E6FFFA" />
                <!-- Truck Wheels -->
                <circle cx="34" cy="67" r="7" fill="#1F2937" />
                <circle cx="34" cy="67" r="3" fill="#E5E7EB" />
                <circle cx="68" cy="67" r="7" fill="#1F2937" />
                <circle cx="68" cy="67" r="3" fill="#E5E7EB" />
                <!-- Scrap / Recyclables in Truck Bed -->
                <rect x="26" y="36" width="12" height="8" rx="1" fill="#F59E0B" />
                <rect x="40" y="32" width="12" height="12" rx="1" fill="#3B82F6" />
                <!-- Leaf / Eco Icon Above -->
                <path d="M50 20C44 20 40 26 40 32C46 32 52 28 52 20Z" fill="#10B981" />
                <path d="M50 20C56 20 60 26 60 32C54 32 48 28 48 20Z" fill="#34D399" />
              </svg>

              <h2 class="text-lg font-bold text-zinc-900 dark:text-white">
                Doorstep Scrap Pickup
              </h2>
              <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1">
                Paper • Metals • Plastics • Electronics • Appliances
              </p>

              <div class="mt-4 inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-600 text-white text-xs font-semibold shadow-sm">
                <span>✓ Verified Weighing at Doorstep</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
