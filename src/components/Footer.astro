---
import { siteConfig } from '../config/site';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<footer class="bg-zinc-900 text-zinc-300 border-t border-zinc-800 mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Col 1: Brand & Tagline -->
      <div class="space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-emerald-500 text-zinc-950 flex items-center justify-center font-bold text-lg">
            ♻️
          </div>
          <span class="text-xl font-bold tracking-tight text-white">
            {siteConfig.siteName}
          </span>
        </div>
        <p class="text-sm text-zinc-400 leading-relaxed">
          {siteConfig.tagline}
        </p>
        <p class="text-xs text-zinc-500">
          Serving households, apartments, offices, and institutions with verified digital weighing and instant payments.
        </p>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold tracking-wider text-white uppercase">
          Quick Links
        </h3>
        <ul class="space-y-2 text-sm text-zinc-400">
          <li>
            <a href={base} class="hover:text-emerald-400 transition-colors">Home</a>
          </li>
          <li>
            <a href={`${base}prices`} class="hover:text-emerald-400 transition-colors flex items-center gap-2">
              <span>Scrap Rates</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800">Live</span>
            </a>
          </li>
          <li>
            <a href={`${base}#schedule-pickup`} class="hover:text-emerald-400 transition-colors">Schedule a Pickup / Call</a>
          </li>
          <li>
            <a href={`${base}#contact-info`} class="hover:text-emerald-400 transition-colors">Our Address</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Contact & Hours -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold tracking-wider text-white uppercase">
          Contact Us
        </h3>
        <div class="space-y-2 text-sm text-zinc-400">
          <p class="flex items-start gap-2">
            <span class="text-emerald-400">📍</span>
            <span>
              {siteConfig.address.line1}, {siteConfig.address.line2}, {siteConfig.address.city}, {siteConfig.address.state} - {siteConfig.address.pincode}
            </span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-emerald-400">📞</span>
            <a href={`tel:${siteConfig.phoneClean}`} class="hover:text-emerald-400 transition-colors">
              {siteConfig.phone}
            </a>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-emerald-400">💬</span>
            <a 
              href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`} 
              target="_blank" 
              rel="noopener noreferrer"
              class="hover:text-emerald-400 transition-colors text-emerald-400 font-medium"
            >
              WhatsApp Support Available
            </a>
          </p>
          <p class="flex items-center gap-2 text-xs text-zinc-500 pt-1">
            <span>⏰</span>
            <span>Hours: {siteConfig.serviceHours}</span>
          </p>
        </div>
      </div>
    </div>

    <div class="border-t border-zinc-800 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-500 gap-4">
      <p>© {new Date().getFullYear()} {siteConfig.siteName}. All rights reserved.</p>
      <p class="text-zinc-500">
        Empowering circular economy & doorstep recycling.
      </p>
    </div>
  </div>
</footer>

